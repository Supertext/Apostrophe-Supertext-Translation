# Supertext Translation for Apostrophe: demo variables.
# On Railway these are service variables; locally pass them with `docker run --env-file`
# (or put them in demo/.env for `node app`). Never commit real values.

# --- Supertext -------------------------------------------------------------------
# No Supertext account yet? Create one at supertext.com:
#   https://www.supertext.com/person/en/account/signin
# Generate your API key at supertext.com → Integrations → API (requires the Admin role):
#   https://www.supertext.com/en/integrations/api
SUPERTEXT_API_KEY=
# Only for tests against a stand-in API (leave empty for the live API).
SUPERTEXT_API_URL=

# --- Demo accounts (created on every start if missing, never changed) --------------
# Apostrophe roles: DEMO_ADMIN is an "admin", DEMO_EDITOR an "editor" (edits and publishes
# all content and localizes it into every locale).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# --- Database ------------------------------------------------------------------------
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}; the demo uses its own database on
# that server (created if missing).
DATABASE_URL=
APOSTROPHE_DB_NAME=supertext_apostrophe
# Or any Apostrophe database URI (MongoDB, PostgreSQL, SQLite), e.g. for local runs:
# APOS_DB_URI=sqlite://./data/dev.db

# --- Apostrophe ----------------------------------------------------------------------
# Any long random string; keep it stable (sessions).
APOS_SESSION_SECRET=
# Public address, if it isn't Railway's RAILWAY_PUBLIC_DOMAIN.
APOS_BASE_URL=
